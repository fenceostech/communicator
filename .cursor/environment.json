{
  "name": "FenceOS Console",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "next-dev",
      "command": "DATABASE_URL=postgresql://fenceos:fenceos@localhost:5432/fenceos pnpm dev",
      "description": "Next.js dev server for the FenceOS console (http://localhost:3000)."
    }
  ],
  "ports": [
    {
      "name": "web",
      "port": 3000
    }
  ]
}
