{
  "name": "FenceOS Console",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "next-dev",
      "command": ": \"${DATABASE_URL:=postgresql://fenceos:fenceos@localhost:5432/fenceos}\"; : \"${SESSION_SECRET:=dev-only-insecure-secret-change-me}\"; export DATABASE_URL SESSION_SECRET; pnpm dev",
      "description": "Next.js dev server. Uses an injected DATABASE_URL (e.g. Supabase) and SESSION_SECRET when present, else local dev defaults."
    }
  ],
  "ports": [
    {
      "name": "web",
      "port": 3000
    }
  ]
}
